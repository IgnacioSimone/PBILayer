<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PBILayer.ico</ApplicationIcon>

    <!-- Identidad y versión (se ven en Propiedades > Detalles, en "Aplicaciones instaladas" y en "Acerca de").
         La versión se cambia SOLO acá: el instalador y el chequeo de actualizaciones la leen de este valor. -->
    <AssemblyName>PBILayer</AssemblyName>
    <AssemblyTitle>PBI Layer</AssemblyTitle>
    <Product>PBI Layer</Product>
    <Description>Documenta un modelo de Power BI y su reporte (medidas, tablas, relaciones, Power Query, visuales y qué se usa) sin tocar datos.</Description>
    <Company>Ignacio Simone</Company>
    <Copyright>© 2026 Ignacio Simone — Licencia MIT</Copyright>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <RepositoryUrl>https://github.com/IgnacioSimone/PBILayer</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- La carpeta publicada traía unas 20 carpetas de idiomas de las dependencias que la app no usa. -->
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PBILayer.ico" />
    <Resource Include="Assets\icon-256.png" />
  </ItemGroup>

  <!-- El SDK incluye .cs recursivamente por default; sin esto, el proyecto de tests
       (subcarpeta PBIExplorer.Tests) se compilaría también acá, sin las referencias
       de xUnit. -->
  <ItemGroup>
    <Compile Remove="PBIExplorer.Tests\**" />
    <None Remove="PBIExplorer.Tests\**" />
    <EmbeddedResource Remove="PBIExplorer.Tests\**" />
  </ItemGroup>

</Project>
