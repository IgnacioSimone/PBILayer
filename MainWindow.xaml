<Window x:Class="PBIExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PBIExplorer.Views"
        xmlns:vm="clr-namespace:PBIExplorer.ViewModels"
        Title="PBI Context" Height="820" Width="1420" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/PBIContext.ico"
        Style="{StaticResource {x:Type Window}}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/SectionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:NullToCollapsedConverter x:Key="NullToCollapsed" />

            <!-- Ítem de navegación lateral, estilo macOS -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
                <Setter Property="FontFamily" Value="{StaticResource FontText}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="8" Margin="10,2" Padding="12,10"
                                    Background="Transparent">
                                <DockPanel>
                                    <!-- Contador: cuántos resultados tiene esta sección para la búsqueda activa -->
                                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                            Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                                            Visibility="{Binding BadgeText, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}" />
                                    </Border>
                                    <TextBlock x:Name="Icon" DockPanel.Dock="Left"
                                               FontFamily="{StaticResource FontIcon}"
                                               Text="{Binding Icon}"
                                               FontSize="15" Width="26" VerticalAlignment="Center"
                                               Foreground="{DynamicResource InkFaint}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentStrong}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource OnAccent}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Aviso (toast): el color del icono indica el tipo -->
            <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                <Border x:Name="ToastCard" Style="{StaticResource Card}" MinWidth="320" MaxWidth="440" Margin="0,10,0,0"
                        Padding="14,12,8,12"
                        AutomationProperties.LiveSetting="Assertive">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastShift" X="24" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ToastCard" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="ToastShift" Storyboard.TargetProperty="X"
                                                     From="24" To="0" Duration="0:0:0.25"
                                                     EasingFunction="{StaticResource EaseOut}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                                Command="{Binding DismissCommand}" ToolTip="Cerrar"
                                AutomationProperties.Name="Cerrar aviso">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                       Foreground="{DynamicResource InkDim}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                Content="{Binding ActionText}" Command="{Binding RunActionCommand}"
                                Visibility="{Binding ActionText, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock x:Name="ToastIcon" DockPanel.Dock="Left" Text="{Binding Icon}"
                                   FontFamily="{StaticResource FontIcon}" FontSize="18"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontText}" FontSize="12.5"
                                   Foreground="{DynamicResource Ink}" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                        <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource StatusGood}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource StatusWarn}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter TargetName="ToastIcon" Property="Foreground" Value="{DynamicResource StatusBad}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding ChoosePbixCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportMarkdownCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportJsonCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ShowShortcutsCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding CycleThemeCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
        <KeyBinding Gesture="Ctrl+PageDown" Command="{Binding NextSectionCommand}" />
        <KeyBinding Gesture="Ctrl+PageUp" Command="{Binding PreviousSectionCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="5" />
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="6" />
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="7" />
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="8" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding GoToSectionCommand}" CommandParameter="9" />
    </Window.InputBindings>

    <Grid x:Name="RootShell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,18">
                    <TextBlock Text="PBI Context"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="Documentación de modelo y reporte"
                               FontFamily="{StaticResource FontSmall}"
                               FontSize="11.5" Foreground="{DynamicResource InkFaint}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="18,10,18,18" Padding="13,11"
                        Background="{DynamicResource PanelTint}" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="PRIVACIDAD"
                                   FontFamily="{StaticResource FontSmall}" FontSize="9.5"
                                   FontWeight="Bold" Foreground="{DynamicResource InkFaint}" />
                        <TextBlock Text="Solo se lee metadata. Nunca se consulta una fila de datos."
                                   FontFamily="{StaticResource FontSmall}" FontSize="11"
                                   Foreground="{DynamicResource InkDim}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tema y ayuda -->
                <Grid DockPanel.Dock="Bottom" Margin="18,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource LinkButton}" HorizontalContentAlignment="Left"
                            Command="{Binding CycleThemeCommand}" ToolTip="Cambiar tema (Ctrl+T)"
                            AutomationProperties.Name="Cambiar tema">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE793;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                       Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ThemeLabel}" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                            x:Name="HelpMenuButton" Click="HelpMenuButton_Click" ToolTip="Ayuda, actualizaciones y acerca de"
                            AutomationProperties.Name="Ayuda y acerca de">
                        <TextBlock Text="&#xE897;" FontFamily="{StaticResource FontIcon}" FontSize="14"
                                   Foreground="{DynamicResource InkDim}" />
                    </Button>
                </Grid>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         VerticalAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Secciones">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Contenido ================= -->
        <Grid Grid.Column="1" Margin="28,26,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedSection.Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="27" FontWeight="Bold"
                               Foreground="{DynamicResource Ink}"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{StaticResource FontSmall}" FontSize="12"
                               Foreground="{DynamicResource InkDim}"
                               TextWrapping="Wrap" Margin="0,5,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                                 Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="Cargando"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancelar" Style="{StaticResource SoftButton}"
                            Command="{Binding CancelCommand}" ToolTip="Cancelar la operación en curso"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Actualizar" Style="{StaticResource SoftButton}"
                            Command="{Binding RefreshCommand}" ToolTip="Volver a leer el modelo y el reporte (F5)" />
                    <Button x:Name="OpenPbixButton" Content="Abrir .pbix" Style="{StaticResource SoftButton}"
                            Command="{Binding ChoosePbixCommand}" ToolTip="Abrir un reporte .pbix (Ctrl+O)" />
                    <Button x:Name="RecentButton" Style="{StaticResource SoftButton}" Click="RecentButton_Click"
                            IsEnabled="{Binding HasRecentFiles}" ToolTip="Reportes abiertos recientemente"
                            AutomationProperties.Name="Reportes recientes" Padding="11,8">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FontIcon}" FontSize="12" />
                    </Button>
                    <Button x:Name="ExportMenuButton" Style="{StaticResource SoftButton}" Click="ExportMenuButton_Click"
                            ToolTip="Exportar a Word, Excel, HTML, CSV o JSON"
                            AutomationProperties.Name="Exportar a otros formatos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Exportar" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FontIcon}" FontSize="11"
                                       Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="Exportar Markdown" Style="{StaticResource AccentButton}"
                            Command="{Binding ExportMarkdownCommand}" ToolTip="Guardar el contexto listo para pegar en un chat con IA (Ctrl+E)" />
                </StackPanel>
            </Grid>

            <!-- Búsqueda global: filtra todas las secciones a la vez y marca cuántos resultados tiene cada una -->
            <TextBox x:Name="GlobalSearchBox" Grid.Row="2" HorizontalAlignment="Left" Width="380"
                     Style="{StaticResource SearchBox}"
                     Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar en todas las secciones (Ctrl+F). Esc para limpiar."
                     AutomationProperties.Name="Buscar en todas las secciones" />

            <Border Grid.Row="4" Style="{StaticResource Card}" ClipToBounds="True">
                <!-- La vista de cada sección sale de Views/SectionTemplates.xaml según el tipo de ViewModel -->
                <ContentControl Content="{Binding SelectedSection}" IsTabStop="False" />
            </Border>
        </Grid>

        <!-- ================= Avisos ================= -->
        <ItemsControl Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                      IsTabStop="False" Focusable="False" />
    </Grid>
</Window>
