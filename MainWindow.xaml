<Window x:Class="PBIExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBI Context" Height="820" Width="1420" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/SectionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Ítem de navegación lateral, estilo macOS -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
                <Setter Property="FontFamily" Value="{StaticResource FontText}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource InkDim}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="8" Margin="10,2" Padding="12,10"
                                    Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Icon"
                                               FontFamily="{StaticResource FontIcon}"
                                               Text="{Binding Icon}"
                                               FontSize="15" Width="26" VerticalAlignment="Center"
                                               Foreground="{StaticResource InkFaint}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6DBC9" />
                                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootShell" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseOut}" />
                    <DoubleAnimation Storyboard.TargetName="RootShellShift" Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="0:0:0.45" EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootShell" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShellShift" Y="12" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource Separator}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,18">
                    <TextBlock Text="PBI Context"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock Text="Documentación de modelo y reporte"
                               FontFamily="{StaticResource FontSmall}"
                               FontSize="11.5" Foreground="{StaticResource InkFaint}"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="18,10,18,18" Padding="13,11"
                        Background="#EBE0CE" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="PRIVACIDAD"
                                   FontFamily="{StaticResource FontSmall}" FontSize="9.5"
                                   FontWeight="Bold" Foreground="{StaticResource InkFaint}" />
                        <TextBlock Text="Solo se lee metadata. Nunca se consulta una fila de datos."
                                   FontFamily="{StaticResource FontSmall}" FontSize="11"
                                   Foreground="{StaticResource InkDim}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         VerticalAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Secciones">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Contenido ================= -->
        <Grid Grid.Column="1" Margin="28,26,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedSection.Title}"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{StaticResource FontSmall}" FontSize="12"
                               Foreground="{StaticResource InkDim}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                                 Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Abrir .pbix"
                            Style="{StaticResource SoftButton}" Command="{Binding ChoosePbixCommand}" />
                    <Button Content="Exportar JSON"
                            Style="{StaticResource SoftButton}" Command="{Binding ExportJsonCommand}" />
                    <Button Content="Exportar Markdown"
                            Style="{StaticResource AccentButton}" Command="{Binding ExportMarkdownCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                <!-- La vista de cada sección sale de Views/SectionTemplates.xaml según el tipo de ViewModel -->
                <ContentControl Content="{Binding SelectedSection}" IsTabStop="False" />
            </Border>
        </Grid>
    </Grid>
</Window>
