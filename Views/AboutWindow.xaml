<Window x:Class="PBIExplorer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PBIExplorer.Views"
        Title="Acerca de PBI Context" Width="540" SizeToContent="Height" MaxHeight="800"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/PBIContext.ico"
        Style="{StaticResource {x:Type Window}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">

            <!-- Identidad -->
            <DockPanel>
                <Image DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,18,0"
                       Source="pack://application:,,,/Assets/icon-256.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontDisplay}" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Ink}" />
                    <TextBlock Text="{Binding VersionLine}" FontSize="13.5" Foreground="{DynamicResource InkDim}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource InkFaint}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource InkDim}"
                       Text="Documenta un modelo de Power BI y su reporte: medidas DAX, tablas, columnas, relaciones, Power Query, qué visual usa qué campo y qué objetos no se usan en ningún lado." />

            <!-- Actualizaciones -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,16">
                <StackPanel DataContext="{Binding Updates}">
                    <TextBlock Text="ACTUALIZACIONES" FontFamily="{StaticResource FontSmall}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource InkFaint}" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource Ink}" AutomationProperties.LiveSetting="Polite" />

                    <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Separator}" BorderThickness="0"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Novedades de la versión nueva -->
                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource SidebarBg}"
                            Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}">
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkDim}" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Buscar ahora" Style="{StaticResource SoftButton}" Margin="0,0,8,0"
                                Command="{Binding CheckNowCommand}" />
                        <Button Content="Descargar e instalar" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                                Command="{Binding InstallCommand}"
                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Ver la versión en GitHub" Style="{StaticResource SoftButton}" Margin="0"
                                Command="{Binding OpenReleasePageCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding AutoCheck}" FontSize="12.5" Foreground="{DynamicResource InkDim}"
                              ToolTip="Es la única conexión de red de la app. No envía ningún dato tuyo, del modelo ni del tablero.">
                        <TextBlock TextWrapping="Wrap" Margin="2,0,0,0"
                                   Text="Buscar actualizaciones automáticamente al abrir (una consulta a GitHub por día, sin enviar datos)" />
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Privacidad -->
            <TextBlock Text="PRIVACIDAD" FontFamily="{StaticResource FontSmall}" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource InkFaint}" Margin="0,22,0,0" />
            <TextBlock Text="{Binding Privacy}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource InkDim}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkFaint}" Margin="0,8,0,0" />

            <!-- Enlaces -->
            <WrapPanel Margin="-10,18,0,0">
                <Button Content="Repositorio" Style="{StaticResource LinkButton}" Command="{Binding OpenUrlCommand}"
                        CommandParameter="https://github.com/IgnacioSimone/PBIContext" />
                <Button Content="Licencia MIT" Style="{StaticResource LinkButton}" Command="{Binding OpenUrlCommand}"
                        CommandParameter="https://github.com/IgnacioSimone/PBIContext/blob/master/LICENSE" />
                <Button Content="Novedades de cada versión" Style="{StaticResource LinkButton}" Command="{Binding OpenUrlCommand}"
                        CommandParameter="https://github.com/IgnacioSimone/PBIContext/blob/master/CHANGELOG.md" />
                <Button Content="Carpeta de datos y registros" Style="{StaticResource LinkButton}" Command="{Binding OpenDataFolderCommand}"
                        ToolTip="{Binding DataFolder}" />
            </WrapPanel>

            <Button Content="Cerrar" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,18,0,0"
                    IsDefault="True" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </ScrollViewer>
</Window>
