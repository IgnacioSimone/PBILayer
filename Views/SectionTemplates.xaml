<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PBIExplorer.ViewModels"
                    xmlns:views="clr-namespace:PBIExplorer.Views">

    <!-- Estilos de celda por estado (colores semánticos) -->
    <Style x:Key="UsageStatusCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Unused">
                <Setter Property="Foreground" Value="{DynamicResource StatusBad}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="InternalOnly">
                <Setter Property="Foreground" Value="{DynamicResource StatusWarn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="InUse">
                <Setter Property="Foreground" Value="{DynamicResource StatusGood}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SeverityCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Alta">
                <Setter Property="Foreground" Value="{DynamicResource StatusBad}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Media">
                <Setter Property="Foreground" Value="{DynamicResource StatusWarn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DiffKindCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Agregado">
                <Setter Property="Foreground" Value="{DynamicResource StatusGood}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Eliminado">
                <Setter Property="Foreground" Value="{DynamicResource StatusBad}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Modificado">
                <Setter Property="Foreground" Value="{DynamicResource StatusWarn}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Una plantilla por sección: el ContentControl de la ventana elige según el tipo de ViewModel -->
    <DataTemplate DataType="{x:Type vm:SummaryViewModel}">
        <views:SummaryView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MeasuresSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Table, Upper=True}" Binding="{Binding Table}" Width="160" />
            <DataGridTextColumn Header="{views:Loc Col_Measure, Upper=True}" Binding="{Binding Name}" Width="230" />
            <DataGridTextColumn Header="{views:Loc Col_Folder, Upper=True}" Binding="{Binding DisplayFolder}" Width="150" />
            <DataGridTextColumn Header="{views:Loc Col_Dax, Upper=True}" Binding="{Binding Expression}" Width="420"
                                FontFamily="{StaticResource FontMono}" FontSize="11.5" />
            <DataGridTextColumn Header="{views:Loc Col_Format, Upper=True}" Binding="{Binding FormatString}" Width="110" />
            <DataGridCheckBoxColumn Header="{views:Loc Col_Hidden, Upper=True}" Binding="{Binding IsHidden}" Width="72" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TablesSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Table, Upper=True}" Binding="{Binding Name}" Width="300" />
            <DataGridTextColumn Header="{views:Loc Col_Columns, Upper=True}" Binding="{Binding ColumnCount}" Width="110" />
            <DataGridTextColumn Header="{views:Loc Col_Measures, Upper=True}" Binding="{Binding MeasureCount}" Width="110" />
            <DataGridTextColumn Header="{views:Loc Col_Description, Upper=True}" Binding="{Binding Description}" Width="320" />
            <DataGridCheckBoxColumn Header="{views:Loc Col_Hidden, Upper=True}" Binding="{Binding IsHidden}" Width="72" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ColumnsSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Table, Upper=True}" Binding="{Binding Table}" Width="210" />
            <DataGridTextColumn Header="{views:Loc Col_Column, Upper=True}" Binding="{Binding Name}" Width="230" />
            <DataGridTextColumn Header="{views:Loc Col_DataType, Upper=True}" Binding="{Binding DataTypeText}" Width="140" />
            <DataGridTextColumn Header="{views:Loc Col_Source, Upper=True}" Binding="{Binding ColumnTypeText}" Width="140" />
            <DataGridTextColumn Header="{views:Loc Col_Folder, Upper=True}" Binding="{Binding DisplayFolder}" Width="130" />
            <DataGridTextColumn Header="{views:Loc Col_DaxOrSource, Upper=True}" Binding="{Binding DaxOrSource}" Width="380"
                                FontFamily="{StaticResource FontMono}" FontSize="11.5" />
            <DataGridCheckBoxColumn Header="{views:Loc Col_Hidden, Upper=True}" Binding="{Binding IsHidden}" Width="72" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RelationshipsSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_From, Upper=True}" Binding="{Binding FromTable}" Width="180" />
            <DataGridTextColumn Header="{views:Loc Col_Column, Upper=True}" Binding="{Binding FromColumn}" Width="180" />
            <DataGridTextColumn Header="{views:Loc Col_To, Upper=True}" Binding="{Binding ToTable}" Width="180" />
            <DataGridTextColumn Header="{views:Loc Col_Column, Upper=True}" Binding="{Binding ToColumn}" Width="180" />
            <DataGridTextColumn Header="{views:Loc Col_Cardinality, Upper=True}" Binding="{Binding CardinalityText}" Width="150" />
            <DataGridTextColumn Header="{views:Loc Col_CrossFilter, Upper=True}" Binding="{Binding CrossFilterText}" Width="180" />
            <DataGridCheckBoxColumn Header="{views:Loc Col_Active, Upper=True}" Binding="{Binding IsActive}" Width="72" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PowerQuerySectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Name, Upper=True}" Binding="{Binding Name}" Width="220" />
            <DataGridTextColumn Header="{views:Loc Col_Kind, Upper=True}" Binding="{Binding KindText}" Width="140" />
            <DataGridTextColumn Header="{views:Loc Col_MCode, Upper=True}" Binding="{Binding MCode}" Width="500"
                                FontFamily="{StaticResource FontMono}" FontSize="11.5" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UsageSectionViewModel}">
        <views:GridSectionView>
            <views:GridSectionView.HeaderContent>
                <CheckBox Content="{views:Loc Usage_OnlyUnused}"
                          FontFamily="{StaticResource FontText}" FontSize="12.5"
                          Foreground="{DynamicResource InkDim}" VerticalAlignment="Center"
                          IsChecked="{Binding OnlyUnused}" />
            </views:GridSectionView.HeaderContent>
            <DataGridTextColumn Header="{views:Loc Col_Kind, Upper=True}" Binding="{Binding KindText}" Width="90" />
            <DataGridTextColumn Header="{views:Loc Col_Table, Upper=True}" Binding="{Binding Table}" Width="170" />
            <DataGridTextColumn Header="{views:Loc Col_Name, Upper=True}" Binding="{Binding Name}" Width="220" />
            <DataGridTextColumn Header="{views:Loc Col_Status, Upper=True}" Binding="{Binding Status}" Width="200"
                                CellStyle="{StaticResource UsageStatusCell}" />
            <DataGridTextColumn Header="{views:Loc Col_DependsOn, Upper=True}" Binding="{Binding DependsOnText}" Width="260"
                                FontFamily="{StaticResource FontMono}" FontSize="11" />
            <DataGridTextColumn Header="{views:Loc Col_UsedBy, Upper=True}" Binding="{Binding UsedByText}" Width="260"
                                FontFamily="{StaticResource FontMono}" FontSize="11" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VisualsSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Page, Upper=True}" Binding="{Binding Page}" Width="200" />
            <DataGridTextColumn Header="{views:Loc Col_Visual, Upper=True}" Binding="{Binding VisualType}" Width="240" />
            <DataGridTextColumn Header="{views:Loc Col_Title, Upper=True}" Binding="{Binding Title}" Width="200" />
            <DataGridTextColumn Header="{views:Loc Col_Kind, Upper=True}" Binding="{Binding FieldKindText}" Width="100" />
            <DataGridTextColumn Header="{views:Loc Col_Table, Upper=True}" Binding="{Binding Table}" Width="180" />
            <DataGridTextColumn Header="{views:Loc Col_Field, Upper=True}" Binding="{Binding Field}" Width="220" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FiltersSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Level, Upper=True}" Binding="{Binding ScopeText}" Width="90" />
            <DataGridTextColumn Header="{views:Loc Col_Page, Upper=True}" Binding="{Binding Page}" Width="150" />
            <DataGridTextColumn Header="{views:Loc Col_Visual, Upper=True}" Binding="{Binding VisualText}" Width="180" />
            <DataGridTextColumn Header="{views:Loc Col_Kind, Upper=True}" Binding="{Binding FieldKindText}" Width="90" />
            <DataGridTextColumn Header="{views:Loc Col_Field, Upper=True}" Binding="{Binding TargetText}" Width="220" />
            <DataGridTextColumn Header="{views:Loc Col_FilterType, Upper=True}" Binding="{Binding FilterType}" Width="130" />
            <DataGridTextColumn Header="{views:Loc Col_Condition, Upper=True}" Binding="{Binding Summary}" Width="360" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PerformanceSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Severity, Upper=True}" Binding="{Binding SeverityText}" Width="90"
                                CellStyle="{StaticResource SeverityCell}" />
            <DataGridTextColumn Header="{views:Loc Col_Category, Upper=True}" Binding="{Binding Category}" Width="190" />
            <DataGridTextColumn Header="{views:Loc Col_Table, Upper=True}" Binding="{Binding Table}" Width="150" />
            <DataGridTextColumn Header="{views:Loc Col_Object, Upper=True}" Binding="{Binding Subject}" Width="220" />
            <DataGridTextColumn Header="{views:Loc Col_Detail, Upper=True}" Binding="{Binding Message}" Width="420" />
        </views:GridSectionView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CompareSectionViewModel}">
        <views:GridSectionView>
            <DataGridTextColumn Header="{views:Loc Col_Change, Upper=True}" Binding="{Binding KindText}" Width="110"
                                CellStyle="{StaticResource DiffKindCell}" />
            <DataGridTextColumn Header="{views:Loc Col_Category, Upper=True}" Binding="{Binding Category}" Width="120" />
            <DataGridTextColumn Header="{views:Loc Col_Object, Upper=True}" Binding="{Binding Name}" Width="260" />
            <DataGridTextColumn Header="{views:Loc Col_Detail, Upper=True}" Binding="{Binding Detail}" Width="420" />
        </views:GridSectionView>
    </DataTemplate>
</ResourceDictionary>
