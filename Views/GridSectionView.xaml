<UserControl x:Class="PBIExplorer.Views.GridSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PBIExplorer.Views"
             x:Name="Root">
    <UserControl.Resources>
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                     Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado: nota, contenido propio de la sección y buscador. Se oculta
             cuando la sección muestra su estado vacío. -->
        <StackPanel Grid.Row="0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Margin="16,14,16,4" TextWrapping="Wrap"
                       FontFamily="{StaticResource FontSmall}" FontSize="11"
                       Foreground="{StaticResource InkFaint}"
                       Text="{Binding Note}"
                       Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />

            <ContentPresenter Margin="16,6,16,4" Content="{Binding HeaderContent, ElementName=Root}" />

            <TextBox Margin="16,14,16,0" Style="{StaticResource SearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  ItemsSource="{Binding View}" />

        <!-- Estado vacío: dice qué está pasando en vez de mostrar una grilla en blanco -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
                <TextBlock Text="{Binding EmptyIcon}" FontFamily="{StaticResource FontIcon}"
                           FontSize="42" Foreground="{StaticResource InkFaint}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyTitle}"
                           FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                           Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="{Binding EmptyBody}"
                           FontFamily="{StaticResource FontText}" FontSize="12.5"
                           Foreground="{StaticResource InkDim}" HorizontalAlignment="Center"
                           Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="{Binding EmptyActionText}" Command="{Binding EmptyActionCommand}"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Visibility="{Binding EmptyActionText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
