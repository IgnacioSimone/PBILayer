<UserControl x:Class="PBIExplorer.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PBIExplorer.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                     Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel Margin="26,24,26,24">
            <!-- Sin datos todavía -->
            <Border Padding="20" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContent}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource FontText}" FontSize="13"
                           Foreground="{DynamicResource InkDim}"
                           Text="{views:Loc Summary_Empty}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,14,14" Cursor="Hand" Focusable="True"
                                Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{views:Loc Tile_Open}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        <Border Style="{StaticResource Card}" Width="232" MinHeight="196" Padding="20"
                                Loaded="Tile_Loaded" MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,0,16"
                                        Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource FontIcon}"
                                               FontSize="17" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Value, StringFormat=N0}" FontSize="32" FontWeight="Bold"
                                           FontFamily="{StaticResource FontText}" Foreground="{DynamicResource Ink}" />
                                <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0"
                                           FontFamily="{StaticResource FontText}" Foreground="{DynamicResource InkDim}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Sub}" FontSize="11" Margin="0,2,0,0"
                                           FontFamily="{StaticResource FontText}" Foreground="{DynamicResource InkFaint}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sub}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,10,0,0"
                                           FontFamily="{StaticResource FontText}" Foreground="{DynamicResource InkFaint}"
                                           TextWrapping="Wrap" LineHeight="16" />
                            </StackPanel>
                        </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
