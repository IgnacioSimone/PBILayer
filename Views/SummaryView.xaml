<UserControl x:Class="PBIExplorer.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                     Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel Margin="26,24,26,24">
            <!-- Sin datos todavía -->
            <Border Padding="20" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContent}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource FontText}" FontSize="13"
                           Foreground="{StaticResource InkDim}"
                           Text="Conectate a un modelo desde Power BI Desktop y/o abrí el .pbix para ver los números acá." />
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="196" MinHeight="152" Padding="20"
                                Margin="0,0,14,14"
                                Loaded="Tile_Loaded" MouseEnter="Tile_MouseEnter" MouseLeave="Tile_MouseLeave">
                            <!-- Sombra y transform propios (no los del Style "Card", compartidos): así el
                                 hover anima solo la tarjeta bajo el mouse. -->
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="18" ShadowDepth="3" Direction="270" />
                            </Border.Effect>
                            <StackPanel>
                                <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,0,16"
                                        Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource FontIcon}"
                                               FontSize="17" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Value, StringFormat=N0}" FontSize="32" FontWeight="Bold"
                                           FontFamily="{StaticResource FontText}" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0"
                                           FontFamily="{StaticResource FontText}" Foreground="{StaticResource InkDim}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Sub}" FontSize="11" Margin="0,2,0,0"
                                           FontFamily="{StaticResource FontText}" Foreground="{StaticResource InkFaint}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sub}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
